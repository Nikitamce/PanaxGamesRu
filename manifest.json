{
  "manifest_version": 3,
  "name": "PANAX RU",
  "version": "0.3.5",
  "description": "Russian UI for panaxgames.com (i18n, no reload).",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://panaxgames.com/*",
    "https://www.panaxgames.com/*",
    "https://api.opencritic.com/*",
    "https://store.steampowered.com/*",
    "https://api.steampowered.com/*",
    "https://www.metacritic.com/*",
    "https://protondb.max-p.me/*",
    "https://www.protondb.com/*",
    "https://steamcharts.com/*",
    "https://open.er-api.com/*",
    "https://latest.currency-api.pages.dev/*",
    "https://clients5.google.com/*",
    "https://api.mymemory.translated.net/*",
    "https://www.backloggd.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "PANAX RU",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://panaxgames.com/*",
        "https://www.panaxgames.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://panaxgames.com/*",
        "https://www.panaxgames.com/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "ratings/*.png",
        "logo/*.png",
        "gamequill/*",
        "fonts/*"
      ],
      "matches": [
        "https://panaxgames.com/*",
        "https://www.panaxgames.com/*"
      ]
    }
  ]
}
